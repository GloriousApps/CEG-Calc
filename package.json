{
  "name": "ceg-calc-1.0",
  "private": true,
  "version": "2.0.2",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "desktop:run": "npm run build && electron .",
    "desktop:portable": "npm run build && electron-builder --win portable"
  },
  "dependencies": {
    "@capacitor-community/file-opener": "^6.0.1",
    "@capacitor/android": "^6.0.0",
    "@capacitor/app": "^6.0.3",
    "@capacitor/browser": "^6.0.6",
    "@capacitor/cli": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@capacitor/filesystem": "^6.0.4",
    "@capacitor/haptics": "^6.0.3",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  },
  "build": {
    "appId": "com.gloriousapps.cegcalc.desktop",
    "productName": "CEG Calc",
    "directories": {
      "output": "release/windows"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "win": {
      "target": ["portable"],
      "artifactName": "CEG_Calc_Portable_v1.0.0.${ext}"
    },
    "portable": {
      "artifactName": "CEG_Calc_Portable_v1.0.0.${ext}"
    }
  }
}
